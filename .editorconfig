root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
# Markdown uses two trailing spaces for line breaks; don't strip them.
trim_trailing_whitespace = false

[*.{yaml,yml,json,jsonc,toml}]
indent_size = 2

[Makefile]
indent_style = tab
